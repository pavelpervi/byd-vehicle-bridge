# BYD account credentials
BYD_USERNAME=your@email.com
BYD_PASSWORD=***
BYD_COUNTRY=IL

# Bridge mode: "minimal" or "full"
#   minimal — Battery SOC, range, driving basics (default). No GPS, no doors.
#   full    — All read-only data: GPS, tires, doors, windows, HVAC, charging.
BYD_MODE=minimal

# Optional: polling interval in seconds (default: 60)
# POLL_INTERVAL=60

# Optional: MCP server port (default: 8000)
# BYD_PORT=8000